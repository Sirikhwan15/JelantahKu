# Server
NODE_ENV=development
PORT=5000

# Database (Neon Console -> Connect -> aktifkan "Connection pooling", salin string-nya)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Auth
JWT_SECRET=isi-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Batas percobaan login/register per IP per 15 menit
AUTH_RATE_LIMIT_MAX=20

# CORS (URL frontend; pisahkan dengan koma bila lebih dari satu)
CORS_ORIGIN=http://localhost:5173
